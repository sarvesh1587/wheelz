PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/wheelz
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE=30d
# Public site address used in email links (defaults to https://wheelz-sand.vercel.app)
SITE_URL=http://localhost:3000
ANTHROPIC_API_KEY=your_anthropic_api_key
# Email. Render's free plan blocks SMTP, so production uses the Gmail API over
# HTTPS. Get the refresh token with: node scripts/gmail-auth.js
EMAIL_FROM=hm2300439@gmail.com
ADMIN_EMAIL=hm2300439@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional SMTP fallback for local development (used only if the Gmail API vars are empty)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary (KYC document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
